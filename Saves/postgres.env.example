# Conexão PostgreSQL do NatumHub (não commitar o arquivo real).
# Copie para Saves/postgres.env e preencha a senha.
#
# Ordem de resolução no app:
#   1) variável de ambiente DATABASE_URL
#   2) Saves/postgres.env  (preferido)
#   3) Saves/supabase.env  (legado)

# --- Opção A: Supabase (atual) — Session pooler :5432 ---
# DATABASE_URL=postgresql://natum_app.SEU_REF:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# --- Opção B: Postgres local / LAN (empresa) ---
DATABASE_URL=postgresql://natum:SENHA@127.0.0.1:5432/natumhub
