# Conexão PostgreSQL do Nexus Industrial Hub (não commitar o arquivo real).
# Copie para Saves/postgres.env e ajuste usuário, senha e host.
#
# Ordem de resolução:
#   1) variável de ambiente DATABASE_URL
#   2) Saves/postgres.env  (preferido)
#   3) Saves/supabase.env  (legado)

# ==============================================================================
# AMBIENTE CASAOS (SERVIDOR DEDICADO)
# ==============================================================================

# --- DESENVOLVIMENTO / BETA (Porta 5433 - Banco Dev Isolado) ---
# Use esta conexão para programar no Antigravity sem risco de afetar a fábrica:
DATABASE_URL=postgresql://postgres:postgres@192.168.1.150:5433/natumhub_dev

# --- PRODUÇÃO (Porta 5432 - Banco Oficial da Fábrica) ---
# Usado pelo container nexus-prod (:3001). Cuidado ao conectar manualmente:
# DATABASE_URL=postgresql://postgres:postgres@192.168.1.150:5432/natumhub

# --- CONEXÃO REMOTA VIA TAILSCALE (FORA DA EMPRESA) ---
# DATABASE_URL=postgresql://postgres:postgres@100.120.161.52:5433/natumhub_dev
