                {savingVinculo && <RefreshCw className="h-3.5 w-3.5 animate-spin" />}
                <span>Confirmar Vínculo</span>
              </button>
            </div>
          </div>
        </div>
      )}
          {/* MODAL DE ENCAIXE PERSONALIZADO NO QUADRO DE ENVASE */}
      {encaixarModalLote && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/40 backdrop-blur-xs animate-in fade-in duration-200">
          <div className="bg-white rounded-xl max-w-xl w-full border border-zinc-200 shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            {/* Header */}
            <div className="p-5 border-b border-zinc-100 flex items-center justify-between bg-zinc-50/50">
              <div className="flex items-center gap-3">
                <div className="p-2.5 bg-purple-100 text-purple-900 rounded-lg">
                  <Layers className="h-5 w-5" />
                </div>
                <div>
                  <h3 className="font-extrabold text-sm text-zinc-900">Encaixar no Quadro de Envase</h3>
                  <p className="text-xs text-zinc-500">Defina linha, categoria e sequência cromática do produto</p>
                </div>
              </div>
              <button
                type="button"
                onClick={() => setEncaixarModalLote(null)}
                className="p-1.5 text-zinc-400 hover:text-zinc-700 hover:bg-zinc-100 rounded-xl transition-colors cursor-pointer"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            {/* Body */}
            <div className="p-5 space-y-4 overflow-y-auto">
              {/* Resumo do Lote */}
              <div className="bg-purple-50/50 border border-purple-200/70 p-3.5 rounded-lg text-xs space-y-1.5">
                <div className="flex items-center justify-between">
                  <span className="font-mono font-extrabold text-purple-950 text-sm">
                    Lote #{encaixarModalLote.loteNumber}
                  </span>
                  <span className="text-[11px] font-mono font-bold px-2 py-0.5 rounded bg-purple-200/70 text-purple-900">
                    SKU: {encaixarModalLote.productCode}
                  </span>
                </div>
                <p className="font-bold text-zinc-900 leading-snug">
                  {encaixarModalLote.productDescription}
                </p>
                <div className="flex items-center gap-4 text-zinc-600 font-mono text-[11px] pt-1">
                  <span>Quantidade: <strong>{Number(encaixarModalLote.quantity || 0).toLocaleString('pt-BR')} un</strong></span>
                  <span>Massa: <strong>{Number(encaixarModalLote.quantityKg || 0).toLocaleString('pt-BR')} kg</strong></span>
                  <span>Data: <strong>{formatEnvaseDateTitle(envaseSelectedDate)}</strong></span>
                </div>
              </div>

              {/* 1. Escolha da Linha */}
              <div className="space-y-1.5">
                <label className="text-xs font-bold text-zinc-700">1. Linha de Envase</label>
                <div className="grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onClick={() => setModalEncaixeLinha('Linha 1')}
                    className={cn(
                      "py-2.5 px-3 rounded-xl font-bold text-xs border transition-all cursor-pointer flex items-center justify-center gap-2",
                      modalEncaixeLinha === 'Linha 1'
                        ? "bg-blue-600 text-white border-blue-600 shadow-xs"
                        : "bg-white text-zinc-700 border-zinc-200 hover:bg-zinc-50"
                    )}
                  >
                    <span>Linha 1</span>
                    <span className="text-[10px] font-mono opacity-80">
                      ({programacaoEnvase.filter(i => i.linha === 'Linha 1').length} lotes)
                    </span>
                  </button>
                  <button
                    type="button"
                    onClick={() => setModalEncaixeLinha('Linha 2')}
                    className={cn(
                      "py-2.5 px-3 rounded-xl font-bold text-xs border transition-all cursor-pointer flex items-center justify-center gap-2",
                      modalEncaixeLinha === 'Linha 2'
                        ? "bg-indigo-600 text-white border-indigo-600 shadow-xs"
                        : "bg-white text-zinc-700 border-zinc-200 hover:bg-zinc-50"
                    )}
                  >
                    <span>Linha 2</span>
                    <span className="text-[10px] font-mono opacity-80">
                      ({programacaoEnvase.filter(i => i.linha === 'Linha 2').length} lotes)
                    </span>
                  </button>
                </div>
              </div>

              {/* 2. Categoria Principal */}
              <div className="space-y-1.5">
                <label className="text-xs font-bold text-zinc-700">2. Categoria Principal</label>
                <div className="grid grid-cols-3 gap-2">
                  {CATEGORIAS_ENVASE.map(cat => (
                    <button
                      key={cat.id}
                      type="button"
                      onClick={() => setModalEncaixeCategoria(cat.id)}
                      className={cn(
                        "py-2 px-2.5 rounded-xl text-xs font-bold border transition-all cursor-pointer flex items-center gap-1.5 justify-center",
                        modalEncaixeCategoria === cat.id
                          ? cn(cat.colorClass, "ring-2 ring-zinc-900 shadow-xs")
                          : "bg-white text-zinc-700 border-zinc-200 hover:bg-zinc-50"
                      )}
                    >
                      <span>{cat.icon}</span>
                      <span>{cat.label}</span>
                    </button>
                  ))}
                </div>
              </div>

              {/* 3. Subcategoria: Base & Cor */}
              <div className="space-y-2 pt-1 border-t border-zinc-100">
                <label className="text-xs font-bold text-zinc-700 flex items-center justify-between">
                  <span>3. Subcategoria: Base & Cor</span>
                  <span className="text-[10px] text-zinc-400 font-normal">Para controle de contaminação e flushing</span>
                </label>

                <div className="grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onClick={() => {
                      setModalEncaixeIsColorido(false);
                      setModalEncaixeCor('Branco');
                    }}
                    className={cn(
                      "py-2 px-3 rounded-xl text-xs font-bold border transition-all cursor-pointer flex items-center justify-center gap-1.5",
                      !modalEncaixeIsColorido
                        ? "bg-zinc-900 text-white border-zinc-900 shadow-xs"
                        : "bg-white text-zinc-700 border-zinc-200 hover:bg-zinc-50"
                    )}
                  >
                    <span>⚪</span>
                    <span>Branco / Neutro</span>
                  </button>
                  <button
                    type="button"
                    onClick={() => {
                      setModalEncaixeIsColorido(true);
                      if (modalEncaixeCor === 'Branco') setModalEncaixeCor('Vermelho');
                    }}
                    className={cn(
                      "py-2 px-3 rounded-xl text-xs font-bold border transition-all cursor-pointer flex items-center justify-center gap-1.5",
                      modalEncaixeIsColorido
                        ? "bg-rose-600 text-white border-rose-600 shadow-xs"
                        : "bg-white text-zinc-700 border-zinc-200 hover:bg-zinc-50"
                    )}
                  >
                    <span>🎨</span>
                    <span>Colorido / Pigmentado</span>
                  </button>
                </div>

                {modalEncaixeIsColorido && (
                  <div className="p-3 bg-zinc-50 rounded-lg border border-zinc-200 space-y-2 animate-in fade-in duration-150">
                    <p className="text-[11px] font-bold text-zinc-600">Selecione a Tonalidade Predominante:</p>
                    <div className="flex flex-wrap gap-1.5">
                      {CORES_PREDEFINIDAS.filter(c => c.id !== 'Branco').map(cor => (
                        <button
                          key={cor.id}
                          type="button"
                          onClick={() => setModalEncaixeCor(cor.id)}
                          className={cn(
                            "px-2.5 py-1 rounded-lg text-xs font-bold border transition-all cursor-pointer flex items-center gap-1.5",
                            modalEncaixeCor === cor.id
                              ? cn(cor.badgeClass, "ring-2 ring-zinc-900 shadow-xs")
                              : "bg-white text-zinc-700 border-zinc-200 hover:bg-zinc-100"
                          )}
                        >
                          <span className={cn("w-2 h-2 rounded-full", cor.dotClass)} />
                          <span>{cor.label}</span>
                        </button>
                      ))}
                    </div>

                    {modalEncaixeCor === 'Outro' && (
                      <input
                        type="text"
                        value={modalEncaixeCustomCor}
                        onChange={e => setModalEncaixeCustomCor(e.target.value)}
                        placeholder="Especifique a cor ou tom do produto..."
                        className="w-full bg-white border border-zinc-200 rounded-xl px-3 py-1.5 text-xs text-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 mt-2"
                      />
                    )}

                    <p className="text-[10px] text-zinc-500 italic mt-1 leading-snug">
                      💡 <strong>Sequência Recomendada:</strong> Claro ao Escuro (ex.: Branco → Amarelo → Laranja → Vermelho → Rosa → Roxo → Azul → Preto).
                    </p>
                  </div>
                )}
              </div>

              {/* 4. Ordem na Fila */}
              <div className="space-y-1.5 pt-1 border-t border-zinc-100">
                <label className="text-xs font-bold text-zinc-700 flex items-center justify-between">
                  <span>4. Posição / Ordem de Execução (Opcional)</span>
                  <span className="text-[10px] text-zinc-400 font-normal">
                    Padrão: {programacaoEnvase.filter(i => i.linha === modalEncaixeLinha).length + 1}º da fila
                  </span>
                </label>
                <input
                  type="number"
                  min="1"
                  value={modalEncaixeOrdem}
                  onChange={e => setModalEncaixeOrdem(e.target.value ? parseInt(e.target.value) : '')}
                  placeholder={`Ex: ${programacaoEnvase.filter(i => i.linha === modalEncaixeLinha).length + 1}`}
                  className="w-full bg-zinc-50 border border-zinc-200 rounded-xl px-3 py-2 text-xs font-mono font-bold text-zinc-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-zinc-900"
                />
              </div>
            </div>

            {/* Footer */}
            <div className="p-4 bg-zinc-50 border-t border-zinc-100 flex items-center justify-end gap-2">
              <button
                type="button"
                onClick={() => setEncaixarModalLote(null)}
                className="px-4 py-2 text-xs font-bold text-zinc-600 hover:bg-zinc-200/60 rounded-xl transition-colors cursor-pointer"
              >
                Cancelar
              </button>
              <button
                type="button"
                onClick={handleConfirmEncaixeModal}
                disabled={savingEncaixeModal}
                className="px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-xs font-bold shadow-xs transition-colors cursor-pointer disabled:opacity-50 flex items-center gap-1.5"
              >
                {savingEncaixeModal && <RefreshCw className="h-3.5 w-3.5 animate-spin" />}
                <span>Confirmar Encaixe no Quadro</span>
              </button>
            </div>
          </div>
        </div>
      )}

    </AppLayout>
  );
}

