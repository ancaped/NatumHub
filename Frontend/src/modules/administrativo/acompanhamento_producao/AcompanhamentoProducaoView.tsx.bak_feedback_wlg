    setLoadingKits(true);
    try {
      const data = await apiJson<KitAssemblyOrder[]>('/api/kits/orders');
      setKitOrders(Array.isArray(data) ? data : []);
    } catch (err) {
      console.error("Erro ao carregar ordens de kits:", err);
    } finally {
      setLoadingKits(false);
