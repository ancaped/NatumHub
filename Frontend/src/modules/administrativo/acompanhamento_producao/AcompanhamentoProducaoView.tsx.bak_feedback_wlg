      setCurrentYear(y => y + 1);
    } else {
      setCurrentMonth(m => m + 1);
    }
  };

  const handleGoToToday = () => {
    setCurrentYear(today.getFullYear());
    setCurrentMonth(today.getMonth());
    const pad = (n: number) => n.toString().padStart(2, '0');
    setSelectedDateIso(`${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`);
  };

  // Grade de dias do Calendário
  const calendarDays = useMemo(() => {
    const firstDayOfMonth = new Date(currentYear, currentMonth, 1);
    const lastDayOfMonth = new Date(currentYear, currentMonth + 1, 0);
    const startingDayOfWeek = firstDayOfMonth.getDay();
    const totalDaysInMonth = lastDayOfMonth.getDate();

    const days: Array<{
      dateIso: string;
      dayNum: number;
      isCurrentMonth: boolean;
      isToday: boolean;
      isWeekend: boolean;
      holiday: HolidayInfo | null;
      items: AcompanhamentoLote[];
      count: number;
      totalKg: number;
      openCount: number;
      completedCount: number;
    }> = [];

    const pad = (n: number) => n.toString().padStart(2, '0');
    const todayIso = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

    // Mês Anterior
    const prevMonthLastDay = new Date(currentYear, currentMonth, 0).getDate();
    for (let i = startingDayOfWeek - 1; i >= 0; i--) {
      const dayNum = prevMonthLastDay - i;
      const prevMonth = currentMonth === 0 ? 11 : currentMonth - 1;
      const prevYear = currentMonth === 0 ? currentYear - 1 : currentYear;
      const dateIso = `${prevYear}-${pad(prevMonth + 1)}-${pad(dayNum)}`;
      const items = lotesByDate.get(dateIso) || [];
      const open = items.filter(x => x.erpStatus !== 'EA' && x.customStatus !== 'Finalizada').length;
      const totalKg = items.reduce((s, x) => s + (Number(x.quantityKg) || 0), 0);
      days.push({
        dateIso,
        dayNum,
        isCurrentMonth: false,
        isToday: dateIso === todayIso,
        isWeekend: isWeekend(dateIso),
        holiday: getHoliday(dateIso),
        items,
        count: items.length,
        totalKg,
        openCount: open,
        completedCount: items.length - open,
      });
    }

    // Mês Atual
    for (let dayNum = 1; dayNum <= totalDaysInMonth; dayNum++) {
      const dateIso = `${currentYear}-${pad(currentMonth + 1)}-${pad(dayNum)}`;
      const items = lotesByDate.get(dateIso) || [];
      const open = items.filter(x => x.erpStatus !== 'EA' && x.customStatus !== 'Finalizada').length;
      const totalKg = items.reduce((s, x) => s + (Number(x.quantityKg) || 0), 0);
      days.push({
        dateIso,
        dayNum,
        isCurrentMonth: true,
        isToday: dateIso === todayIso,
        isWeekend: isWeekend(dateIso),
        holiday: getHoliday(dateIso),
        items,
        count: items.length,
        totalKg,
        openCount: open,
        completedCount: items.length - open,
      });
    }

    // Próximo Mês
    const totalSlots = days.length > 35 ? 42 : 35;
    const remainingSlots = totalSlots - days.length;
    for (let dayNum = 1; dayNum <= remainingSlots; dayNum++) {
      const nextMonth = currentMonth === 11 ? 0 : currentMonth + 1;
      const nextYear = currentMonth === 11 ? currentYear + 1 : currentYear;
      const dateIso = `${nextYear}-${pad(nextMonth + 1)}-${pad(dayNum)}`;
      const items = lotesByDate.get(dateIso) || [];
      const open = items.filter(x => x.erpStatus !== 'EA' && x.customStatus !== 'Finalizada').length;
      const totalKg = items.reduce((s, x) => s + (Number(x.quantityKg) || 0), 0);
      days.push({
        dateIso,
        dayNum,
        isCurrentMonth: false,
        isToday: dateIso === todayIso,
        isWeekend: isWeekend(dateIso),
        holiday: getHoliday(dateIso),
        items,
        count: items.length,
        totalKg,
        openCount: open,
        completedCount: items.length - open,
      });
    }

    return days;
  }, [currentYear, currentMonth, lotesByDate, today]);

  // Detalhes do dia selecionado no Calendário
  const selectedDayInfo = useMemo(() => {
    if (!selectedDateIso) return null;
    const items = lotesByDate.get(selectedDateIso) || [];
    const [y, m, d] = selectedDateIso.split('-').map(Number);
    const dateObj = new Date(y, m - 1, d);
    const dayOfWeekName = [
      'Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira',
      'Quinta-feira', 'Sexta-feira', 'Sábado'
    ][dateObj.getDay()];

    const openCount = items.filter(x => x.erpStatus !== 'EA' && x.customStatus !== 'Finalizada').length;
    const totalKg = items.reduce((s, x) => s + (Number(x.quantityKg) || 0), 0);
    const totalUnidades = items.reduce((s, x) => s + (Number(x.quantity) || 0), 0);

    return {
      dateIso: selectedDateIso,
      dayFormatted: `${d.toString().padStart(2, '0')}/${m.toString().padStart(2, '0')}/${y}`,
      dayOfWeekName,
      holiday: getHoliday(selectedDateIso),
      isWeekend: isWeekend(selectedDateIso),
      items,
      count: items.length,
      totalKg,
      totalUnidades,
      openCount,
      completedCount: items.length - openCount,
    };
  }, [selectedDateIso, lotesByDate]);


  const formatEnvaseDateTitle = (dateStr: string) => {
    if (!dateStr) return '';
    const [year, month, day] = dateStr.split('-').map(Number);
    if (!year || !month || !day) return dateStr;
    const d = new Date(year, month - 1, day);
    return d.toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  };

  const handlePrevDayEnvase = () => {
    const [y, m, d] = envaseSelectedDate.split('-').map(Number);
    const date = new Date(y, m - 1, d - 1);
    setEnvaseSelectedDate(`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`);
  };

  const handleNextDayEnvase = () => {
    const [y, m, d] = envaseSelectedDate.split('-').map(Number);
    const date = new Date(y, m - 1, d + 1);
    setEnvaseSelectedDate(`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`);
  };

  const handleTodayEnvase = () => {
    const d = new Date();
    setEnvaseSelectedDate(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`);
  };

  const envaseLinha1Items = useMemo(() => {
    let list = programacaoEnvase.filter(it => it.linha === 'Linha 1');
    if (envaseCategoryFilter !== 'TODOS') {
      list = list.filter(it => it.categoriaEnvase === envaseCategoryFilter);
    }
    return list.sort((a, b) => a.ordem - b.ordem);
  }, [programacaoEnvase, envaseCategoryFilter]);

  const envaseLinha2Items = useMemo(() => {
    let list = programacaoEnvase.filter(it => it.linha === 'Linha 2');
    if (envaseCategoryFilter !== 'TODOS') {
      list = list.filter(it => it.categoriaEnvase === envaseCategoryFilter);
    }
    return list.sort((a, b) => a.ordem - b.ordem);
  }, [programacaoEnvase, envaseCategoryFilter]);

  const envaseDayStats = useMemo(() => {
    const allLinha1 = programacaoEnvase.filter(it => it.linha === 'Linha 1');
    const allLinha2 = programacaoEnvase.filter(it => it.linha === 'Linha 2');
    const totalUn1 = allLinha1.reduce((sum, it) => sum + (Number(it.quantity) || 0), 0);
    const totalKg1 = allLinha1.reduce((sum, it) => sum + (Number(it.quantityKg) || 0), 0);
    const totalUn2 = allLinha2.reduce((sum, it) => sum + (Number(it.quantity) || 0), 0);
    const totalKg2 = allLinha2.reduce((sum, it) => sum + (Number(it.quantityKg) || 0), 0);

    return {
      linha1Count: allLinha1.length,
      linha1Un: totalUn1,
      linha1Kg: totalKg1,
      linha2Count: allLinha2.length,
      linha2Un: totalUn2,
      linha2Kg: totalKg2,
      totalCount: programacaoEnvase.length,
      totalUn: totalUn1 + totalUn2,
      totalKg: totalKg1 + totalKg2,
    };
  }, [programacaoEnvase]);

  const lotesParaEncaixe = useMemo(() => {
    const scheduledLoteNumbers = new Set(programacaoEnvase.map(it => it.loteNumber));
    return lotes
      .filter(l => !isLoteTerceirizado(l))
      .filter(l => {
        const eff = getEffectiveStatus(l);
        // REGRA ESTRITA: Somente lotes com status 'Produzido' ou 'Liberado para Envase'
        const isApto = (eff === 'Produzido' || eff === 'Liberado para Envase' || l.customStatus === 'Produzido' || l.customStatus === 'Liberado para Envase') && eff !== 'Pesagem' && eff !== 'Em Espera' && eff !== 'Finalizada' && l.erpStatus !== 'EA';
        if (!isApto) return false;

        if (encaixeStatusFilter === 'TODOS') {
          return true;
        }
        return eff === encaixeStatusFilter;
      })
      .filter(l => {
        if (!encaixeSearch.trim()) return true;
        const q = encaixeSearch.toLowerCase();
        return (
          (l.loteNumber || '').toLowerCase().includes(q) ||
          (l.productCode || '').toLowerCase().includes(q) ||
          (l.productDescription || '').toLowerCase().includes(q)
        );
      })
      .map(l => {
        const scheduledItem = programacaoEnvase.find(it => it.loteNumber === l.loteNumber);
        return {
          ...l,
          isAlreadyScheduled: !!scheduledItem,
          scheduledItem
        };
      });
  }, [lotes, isLoteTerceirizado, programacaoEnvase, encaixeStatusFilter, encaixeSearch]);

  // Lotes para o Quadro de Pesagem (Fila de Pesagem com Navegação de Datas e Insumos)
  const lotesPesagem = useMemo(() => {
    return lotes
      .filter(l => !isLoteTerceirizado(l))
      .filter(l => {
        const eff = getEffectiveStatus(l);
        const isPesagem = (eff === 'Pesagem' || (!l.customStatus && l.erpStatus === 'PG')) && eff !== 'Finalizada' && eff !== 'Ordem Finalizada' && l.erpStatus !== 'EA';
        if (!isPesagem) return false;
        if (pesagemStatusFilter === 'AGUARDANDO' && l.customStatus === 'Pesagem') return false;
        if (pesagemStatusFilter === 'EM_PESAGEM' && l.customStatus !== 'Pesagem') return false;
        if (selectedInsumoFaltanteFilter !== 'TODOS') {
          if ((l.insumoFaltanteCodigo || (l as any).insumo_faltante_codigo) !== selectedInsumoFaltanteFilter) return false;
        }
        if (!pesagemShowAllDates) {
          const dt = parseLoteDateToIso(l.dataPesagem || l.date);
          if (dt !== pesagemSelectedDate) return false;
        }
        return true;
      })
      .filter(l => {
        if (!pesagemSearch.trim()) return true;
        const q = pesagemSearch.toLowerCase();
        return (
          (l.loteNumber || '').toLowerCase().includes(q) ||
          (l.productCode || '').toLowerCase().includes(q) ||
          (l.productDescription || '').toLowerCase().includes(q) ||
          (l.motivoEspera || '').toLowerCase().includes(q)
        );
      });
  }, [lotes, isLoteTerceirizado, pesagemStatusFilter, pesagemSearch, pesagemShowAllDates, pesagemSelectedDate, selectedInsumoFaltanteFilter]);

  // Lotes para o Quadro de Produção (Manipulação em Reatores com Navegação de Datas e Insumos)
  const lotesProducao = useMemo(() => {
    return lotes
      .filter(l => !isLoteTerceirizado(l))
      .filter(l => {
        const eff = getEffectiveStatus(l);
        const isProd = (eff === 'Produção' || eff === 'Produzido' || l.customStatus === 'Produção' || l.customStatus === 'Produzido' || (!l.customStatus && l.erpStatus === 'PR')) && eff !== 'Finalizada' && eff !== 'Ordem Finalizada' && l.erpStatus !== 'EA';
        if (!isProd) return false;
        if (producaoCategoryFilter !== 'TODOS') {
          const cat = inferCategoriaEnvase(l.productDescription);
          if (cat !== producaoCategoryFilter) return false;
        }
        if (selectedInsumoFaltanteFilter !== 'TODOS') {
          if ((l.insumoFaltanteCodigo || (l as any).insumo_faltante_codigo) !== selectedInsumoFaltanteFilter) return false;
        }
        if (!producaoShowAllDates) {
          const dt = parseLoteDateToIso(l.dataProducao || l.date);
          if (dt !== producaoSelectedDate) return false;
        }
        return true;
      })
      .filter(l => {
        if (!producaoSearch.trim()) return true;
        const q = producaoSearch.toLowerCase();
        return (
          (l.loteNumber || '').toLowerCase().includes(q) ||
          (l.productCode || '').toLowerCase().includes(q) ||
          (l.productDescription || '').toLowerCase().includes(q) ||
          (l.motivoEspera || '').toLowerCase().includes(q)
        );
      });
  }, [lotes, isLoteTerceirizado, producaoCategoryFilter, producaoSearch, producaoShowAllDates, producaoSelectedDate, selectedInsumoFaltanteFilter]);

  const getCategoriaBadgeClass = (categoria: string) => {
    const found = CATEGORIAS_ENVASE.find(c => c.id === categoria);
    return found ? found.colorClass : 'bg-zinc-100 text-zinc-800 border-zinc-300';
