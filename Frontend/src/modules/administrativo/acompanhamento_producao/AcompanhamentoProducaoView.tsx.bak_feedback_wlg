      const eff = getEffectiveStatus(l);
      const isConcluido = eff === 'Ordem Finalizada' || eff === 'Finalizada' || l.erpStatus === 'EA';
      if (!isConcluido) aberto++;
      if (l.erpStatus === 'EA' || eff === 'Ordem Finalizada' || eff === 'Finalizada') concluidoEa++;

      if (eff === 'Pesagem') pesagem++;
      else if (eff === 'Produzido' || eff === 'Produção') produzido++;
      else if (eff === 'Liberado para Envase') liberadoEnvase++;
      else if (eff === 'Envase') envase++;
      else if (eff === 'Rotulagem') rotulagem++;
      else if (eff === 'Em Espera' || l.motivoEspera) espera++;
      else if (eff === 'Ordem Finalizada' || eff === 'Finalizada') finalizada++;
      else pendente++;
    });

    return {
      todos: list.length,
      aberto,
      concluidoEa,
      pesagem,
      produzido,
      liberadoEnvase,
