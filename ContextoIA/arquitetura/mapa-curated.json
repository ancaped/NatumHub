{
  "glossary": {
    "module_key": "Chave de permissão snake_case (ex.: qualidade_documentacao). Espelhada FE registry.ts ↔ BE modules_registry.rs.",
    "hubView": "View intermediária do hub (ex.: qualidade_hub) visível se o operador tiver qualquer filho do grupo.",
    "PC Principal": "Instalação master: sobe Axum :3001, Postgres, sync ERP, backups e updater.",
    "Terminal": "Cliente: só UI; apiOrigin aponta para o PC Principal; sem Postgres local.",
    "apiJson": "Cliente HTTP autenticado em Frontend/src/modules/geral/lib/http.ts — nunca fetch cru.",
    "Saves": "Pasta local no master (postgres.env, PDFs, backups, manifests). Não versionar secrets."
  },
  "infraNodes": {
    "auth": { "label": "Auth", "purpose": "Login, sessões, middleware Bearer, permissões por module_key." },
    "notifications": { "label": "Notificações", "purpose": "hub_notifications + sino na UI." },
    "audit": { "label": "Auditoria", "purpose": "hub_audit_events — trilha HTTP write + eventos de domínio." },
    "postgres": { "label": "PostgreSQL", "purpose": "Banco canônico do Hub (Saves/postgres.env)." },
    "erp": { "label": "SQL Server ERP", "purpose": "Fonte legada; sync via erp-import / legacy_db." },
    "saves": { "label": "Disco Saves/", "purpose": "Arquivos binários (PDF, receipts, backups)." }
  },
  "routePrefixes": [
    { "prefix": "/api/qualidade/documentacao", "moduleKey": "qualidade_documentacao", "summary": "CRUD documentação / PDF / alertas" },
    { "prefix": "/api/almox", "moduleKey": "estoque_almoxarifado", "summary": "Almoxarifado ops (itens, movimentos, equipamentos)" },
    { "prefix": "/api/estoque", "moduleKey": "estoque_produtos", "summary": "Estoque / contagens / item-info" },
    { "prefix": "/api/compras", "moduleKey": "compras_pedidos", "summary": "Pedidos, notas, lojas online (API compras)" },
    { "prefix": "/api/hub/compras", "moduleKey": "compras_quotations", "summary": "Hub compras: cotações, itens, demandas, imports" },
    { "prefix": "/api/expedicao", "moduleKey": "expedicao_ecommerce", "summary": "Pedidos e-commerce e lookups" },
    { "prefix": "/api/financeiro", "moduleKey": "financeiro", "summary": "Contas / fluxo Tiny" },
    { "prefix": "/api/vendas", "moduleKey": "vendas", "summary": "Pedidos de venda e faltas" },
    { "prefix": "/api/hub/microbio", "moduleKey": "microbiologia", "summary": "Laudos e config microbiologia" },
    { "prefix": "/api/hub/fisco", "moduleKey": "fisco_quimica", "summary": "Análises físico-químicas" },
    { "prefix": "/api/hub/feedbacks", "moduleKey": "hub_settings", "summary": "Feedbacks admin" },
    { "prefix": "/api/auth", "moduleKey": "hub_operadores", "summary": "Login, operadores, dispositivos" },
    { "prefix": "/api/admin/audit/events", "moduleKey": "hub_settings", "summary": "Lista trilha hub_audit_events (supervisor)" },
    { "prefix": "/api/admin", "moduleKey": "hub_settings", "summary": "Admin: backup, DB, audit estoque" },
    { "prefix": "/api/import", "moduleKey": "hub_settings", "summary": "Sync ERP / dump / status" },
    { "prefix": "/api/notifications", "moduleKey": "hub_settings", "summary": "Sino de notificações" },
    { "prefix": "/api/kits", "moduleKey": "montagem_kits", "summary": "Kits e composição" },
    { "prefix": "/api/producao", "moduleKey": "producao_lotes", "summary": "Lotes e recálculo" },
    { "prefix": "/api/historico", "moduleKey": "producao", "summary": "Histórico de produção" },
    { "prefix": "/api/turnovers", "moduleKey": "producao", "summary": "Virações / turnovers" },
    { "prefix": "/api/products", "moduleKey": "admin_linha_produtos", "summary": "Catálogo produtos" },
    { "prefix": "/api/produtos", "moduleKey": "admin_linha_produtos", "summary": "Detalhes / formulação produto" },
    { "prefix": "/api/overrides", "moduleKey": "admin_linha_produtos", "summary": "Overrides de produto" },
    { "prefix": "/api/configs", "moduleKey": "hub_settings", "summary": "Configs genéricas" },
    { "prefix": "/api/settings", "moduleKey": "hub_settings", "summary": "Settings chave/valor" },
    { "prefix": "/api/hub", "moduleKey": "hub_settings", "summary": "Status / client-config / health" },
    { "prefix": "/api/health", "moduleKey": "hub_settings", "summary": "Healthcheck público" }
  ],
  "modules": {
    "qualidade_documentacao": {
      "label": "Documentação",
      "purpose": "Cadastro de documentos de qualidade com PDF no disco do master, localização física, validade com alertas e controle de pagamento/comprovante.",
      "status": "live",
      "frontend": {
        "view": "QualidadeDocumentacaoView",
        "path": "Frontend/src/modules/qualidade/documentacao/"
      },
      "backend": {
        "path": "Backend/src/modules/qualidade/documentacao/",
        "routerPrefix": "/api/qualidade/documentacao"
      },
      "permissions": { "rolesDefault": ["qualidade", "admin"], "supervisorOnly": false },
      "data": {
        "tables": ["doc_families", "doc_types", "documents", "document_files"],
        "filesOnDisk": ["Saves/documentacao/"]
      },
      "connectsTo": [
        { "target": "notifications", "kind": "notify", "note": "check-alerts → hub_notifications" },
        { "target": "auth", "kind": "guard", "note": "module_key qualidade_documentacao" },
        { "target": "saves", "kind": "files", "note": "PDFs em Saves/documentacao/{doc_id}/" },
        { "target": "postgres", "kind": "data", "note": "metadados migration 016" },
        { "target": "audit", "kind": "audit", "note": "eventos create/update/delete documento" }
      ],
      "aiHints": [
        "AppLayout com abas Documentos / Pendências / Famílias; sem h1 no main",
        "PDFs via saves_dir()/documentacao — não ../receipts",
        "apiJson / multipart FormData para upload",
        "warn_days padrão 30/15/7 por família"
      ],
      "routeSummaries": {
        "GET /api/qualidade/documentacao/families": "Lista famílias de documentos",
        "POST /api/qualidade/documentacao/families": "Cria família",
        "PUT /api/qualidade/documentacao/families/:id": "Atualiza família",
        "DELETE /api/qualidade/documentacao/families/:id": "Remove família (se sem docs)",
        "GET /api/qualidade/documentacao/types": "Lista tipos (filtro family_id)",
        "POST /api/qualidade/documentacao/types": "Cria tipo",
        "PUT /api/qualidade/documentacao/types/:id": "Atualiza tipo",
        "DELETE /api/qualidade/documentacao/types/:id": "Remove tipo",
        "GET /api/qualidade/documentacao/documents": "Lista documentos",
        "POST /api/qualidade/documentacao/documents": "Cria documento",
        "GET /api/qualidade/documentacao/documents/:id": "Detalhe documento + arquivos",
        "PUT /api/qualidade/documentacao/documents/:id": "Atualiza documento",
        "DELETE /api/qualidade/documentacao/documents/:id": "Remove documento e PDFs",
        "POST /api/qualidade/documentacao/documents/:id/files": "Upload PDF (documento|comprovante)",
        "GET /api/qualidade/documentacao/files/:id": "Download arquivo",
        "DELETE /api/qualidade/documentacao/files/:id": "Remove arquivo",
        "POST /api/qualidade/documentacao/check-alerts": "Gera notificações de validade/pagamento"
      }
    },
    "estoque_almoxarifado": {
      "label": "Almoxarifado",
